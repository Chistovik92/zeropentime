<!--
  SPDX-License-Identifier: MPL-2.0

  Установщик узла zeropentime для Windows (WiX Toolset 5):
    - zpt.exe и wintun.dll в Program Files\zeropentime, папка — в PATH;
    - служба "zeropentime" (zpt up -c ProgramData\zeropentime\zpt.yaml),
      автозапуск, перезапуск при сбое;
    - конфиг ProgramData\zeropentime\zpt.yaml (не перезаписывается при
      обновлении и остаётся после удаления вместе с ключом и состоянием);
    - обработчик ссылок zpt:// ("zpt open");
    - трей zpt-tray.exe: автозапуск при входе любого пользователя, ярлык в «Пуске».
  Сборка: scripts/build-msi.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="zeropentime" Manufacturer="zeropentime" Version="$(Version)"
           UpgradeCode="32D8D5F8-EFCE-4749-AADF-EAC473371C93" Scope="perMachine" Compressed="yes"
           Language="1049" Codepage="1251">
    <SummaryInformation Description="Узел zeropentime: виртуальные LAN на AmneziaWG" Manufacturer="zeropentime" />
    <MajorUpgrade DowngradeErrorMessage="Уже установлена более новая версия zeropentime." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Chistovik92/zeropentime" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="zeropentime">
        <Component Id="Node">
          <File Id="ZptExe" Source="$(BinDir)\zpt.exe" KeyPath="yes" />
          <ServiceInstall Id="Service" Name="zeropentime" DisplayName="zeropentime"
                          Description="Узел zeropentime: виртуальные LAN на AmneziaWG"
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                          Arguments="up -c &quot;[CommonAppDataFolder]zeropentime\zpt.yaml&quot;">
            <util:ServiceConfig xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
                                FirstFailureActionType="restart" SecondFailureActionType="restart"
                                ThirdFailureActionType="restart" RestartServiceDelayInSeconds="3" ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="ServiceControl" Name="zeropentime" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
          <RegistryKey Root="HKLM" Key="Software\Classes\zpt">
            <RegistryValue Type="string" Value="URL:zeropentime" />
            <RegistryValue Name="URL Protocol" Type="string" Value="" />
            <RegistryKey Key="DefaultIcon">
              <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]zpt.exe&quot;,0" />
            </RegistryKey>
            <RegistryKey Key="shell\open\command">
              <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]zpt.exe&quot; open &quot;%1&quot;" />
            </RegistryKey>
          </RegistryKey>
        </Component>
        <Component Id="Tray">
          <File Id="TrayExe" Source="$(BinDir)\zpt-tray.exe" KeyPath="yes" />
          <!-- The tray starts with every user's session. -->
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="zeropentime"
                         Type="string" Value="&quot;[INSTALLFOLDER]zpt-tray.exe&quot;" />
        </Component>
        <Component Id="Wintun">
          <File Id="WintunDll" Source="$(BinDir)\wintun.dll" KeyPath="yes" />
          <File Id="WintunLicense" Source="$(BinDir)\wintun-LICENSE.txt" />
        </Component>
        <Component Id="License">
          <File Id="License" Source="$(SrcDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="Licensing">
          <File Id="Licensing" Source="$(SrcDir)\LICENSING.md" KeyPath="yes" />
        </Component>
        <Component Id="Readme">
          <File Id="Readme" Source="$(SrcDir)\README.md" KeyPath="yes" />
        </Component>
        <Component Id="Changelog">
          <File Id="Changelog" Source="$(SrcDir)\CHANGELOG.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Shortcut">
        <Shortcut Id="TrayShortcut" Name="zeropentime" Description="Комнаты zeropentime в области уведомлений"
                  Target="[INSTALLFOLDER]zpt-tray.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\zeropentime" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="zeropentime">
        <Component Id="Config" NeverOverwrite="yes" Permanent="yes">
          <File Id="ConfigFile" Source="$(SrcDir)\deploy\packaging\zpt.yaml" Name="zpt.yaml" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="zeropentime">
      <ComponentRef Id="Node" />
      <ComponentRef Id="Tray" />
      <ComponentRef Id="Shortcut" />
      <ComponentRef Id="Wintun" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Licensing" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="Changelog" />
      <ComponentRef Id="Config" />
    </Feature>
  </Package>
</Wix>
